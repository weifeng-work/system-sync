-        commitBuffer(false);
-        context_->mutableDict().removeWord(code, word);
-        context_->mutableModel().history().forget(word);
-    } else {
+    // 词组候选 TableContext::code() 返回空串,改用当前输入编码。
+    if (code.empty()) {
+        code = context_->userInput();
+    }
+    if (code.empty()) {
         return;
     }
+    auto word = context_->candidates()[idx].toString();
+    commitBuffer(false);
+    context_->mutableDict().removeWord(code, word);
+    context_->mutableModel().history().forget(word);
     context_->clear();
     {
         const CommitAfterSelectWrapper commitAfterSelectRAII(this);
@@ -1438,4 +1442,58 @@ void TableState::updatePuncPreedit(InputContext *inputContext) {
     }
 }
 
+bool TableState::forgetCandidateByIndex(size_t idx) {
+    auto *context = context_.get();
+    if (!context) {
+        return false;
+    }
+    if (idx >= context->candidates().size()) {
+        return false;
+    }
+    forgetCandidateWord(idx);
+    return true;
+}
+
+bool TableState::promoteCandidate(size_t idx) {
+    auto *context = context_.get();
+    if (!context) {
+        return false;
+    }
+    auto candidates = context->candidates();
+    size_t i = 0;
+    for (auto iter = candidates.begin(); iter != candidates.end();
+         ++iter, ++i) {
+        if (i == idx) {
+            const auto &sr = *iter;
+            std::string word = sr.toString();
+            if (word.empty()) {
+                return false;
+            }
+            std::string candCode = libime::TableContext::code(sr);
+            if (candCode.empty()) {
+                candCode = context->userInput();
+            }
+            if (candCode.empty()) {
+                return false;
+            }
+            // 把候选提升为用户词。libime 的 shouldReplaceCandidate
+            // (tablecontext.cpp)现在允许 User flag 词组替换同编码的
+            // 普通候选,因此插入 User 词后重新解码即可让该词排前。
+            auto ret = context->mutableDict().insert(candCode, word,
+                                                     libime::PhraseFlag::User);
+            if (ret) {
+                // 候选列表是 TableContext::update() 的缓存,直接 insert
+                // 不会刷新。clear 后重新 type 当前编码触发重新解码,
+                // 让被提升的词立即排到前面。
+                const auto oldCode = context->userInput();
+                context->clear();
+                context->type(oldCode);
+                updateUI(false, false);
+            }
+            return ret;
+        }
+    }
+    return false;
+}
+
 } // namespace fcitx
